## Copy this file to .env and fill in values for local development.
# Do NOT commit .env with secrets.

# Google Document AI
GOOGLE_API_KEY=
DOCUMENT_AI_PROCESSOR=projects/PROJECT/locations/LOCATION/processors/PROCESSOR_ID

# AWS (Textract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# LLM / Models
# Choose provider: `google`, `openai`, or `anthropic`
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

# Provider-specific keys (set only the ones you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Infrastructure
REDIS_URL=redis://localhost:6379/0
DATABASE_DSN=postgresql://user:password@localhost:5432/plc

# Pipeline
METRICS_PORT=8000
PIPELINE_TMP=/tmp/pipeline_orchestrator
